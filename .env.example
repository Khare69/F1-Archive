# F1 Archive Environment Configuration Example
# Copy to .env.local for local overrides

# Application metadata
VITE_APP_TITLE=F1 // ARCHIVE

# API Endpoints
VITE_JOLPICA_API_BASE=https://api.jolpi.ca/ergast/f1

# Optional: Tier 2 FastAPI Historian Backend (leave empty for pure Tier 1 client engine)
VITE_HISTORIAN_API_URL=

# Optional: Production Observability (Sentry / PostHog)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Feature toggles
VITE_ENABLE_ANALYTICS=false
