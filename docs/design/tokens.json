{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "F1 // ARCHIVE Design Tokens",
  "version": "1.0.0",
  "surface": {
    "canvas": "#090B10",
    "canvasSubtle": "#0A0C10",
    "panel": "#11151E",
    "elevated": "#181E2A",
    "overlay": "rgba(9, 11, 16, 0.88)",
    "glass": "rgba(17, 21, 30, 0.75)"
  },
  "border": {
    "hairline": "rgba(255, 255, 255, 0.08)",
    "subtle": "rgba(255, 255, 255, 0.12)",
    "active": "rgba(255, 255, 255, 0.24)",
    "focus": "#E10600"
  },
  "text": {
    "primary": "#F4F6FA",
    "secondary": "#94A3B8",
    "muted": "#8494AB",
    "disabled": "#64748B",
    "contrastRatioOnPanel": "11.2:1 (primary), 6.5:1 (secondary), 4.8:1 (muted - WCAG AA pass)"
  },
  "accent": {
    "crimson": "#E10600",
    "crimsonHover": "#FF1801",
    "crimsonSubtle": "rgba(225, 6, 0, 0.15)"
  },
  "telemetry": {
    "sectorPurple": "#A855F7",
    "sectorGreen": "#22C55E",
    "sectorYellow": "#EAB308",
    "tyreSoft": "#E10600",
    "tyreMedium": "#FFD300",
    "tyreHard": "#F0F0F0",
    "tyreInter": "#39B54A",
    "tyreWet": "#0090FF",
    "drsActive": "#00F0FF",
    "speedTrace": "#FF8700"
  },
  "teams": {
    "red_bull": "#3671C6",
    "ferrari": "#E8002D",
    "mercedes": "#27F4D2",
    "mclaren": "#FF8000",
    "aston_martin": "#229971",
    "alpine": "#0093CC",
    "williams": "#64C4FF",
    "rb": "#6692FF",
    "sauber": "#52E252",
    "haas": "#B6BABD"
  },
  "typography": {
    "fontSans": "'Inter Variable', 'Inter', system-ui, sans-serif",
    "fontMono": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace",
    "headingLetterSpacing": "+0.08em",
    "numericFeatures": "tabular-nums"
  },
  "radii": {
    "none": "0px",
    "sm": "2px",
    "default": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "shadows": {
    "panel": "0 4px 20px -2px rgba(0, 0, 0, 0.5)",
    "modal": "0 20px 40px -4px rgba(0, 0, 0, 0.7)",
    "glowCrimson": "0 0 16px rgba(225, 6, 0, 0.35)"
  }
}
